# ============================================================================
# LOTIS V1 -- konfiguracja lokalna
# ----------------------------------------------------------------------------
# Ten plik NIE trafia do repozytorium (jest w .gitignore). Wzorzec bez sekretow
# lezy w .env.example.
#
# Zasada pierwszenstwa: zmienna ustawiona w terminalu wygrywa z tym plikiem.
# ============================================================================

# ---- Warstwa AI (OUTPUT 2) -- OpenRouter -----------------------------------

# Klucz zalozysz na https://openrouter.ai/keys
# Bez niego dziala wszystko poza samym wywolaniem modelu; tryb --dry-run
# sklada gotowy prompt do pliku i nie dzwoni nigdzie.
OPENROUTER_API_KEY=

# Slug modelu -- wklej dowolny z https://openrouter.ai/models
# Zywa liste wypisze: lotis models
LOTIS_AI_MODEL=minimax/minimax-m3:free

# Naglowki, ktore OpenRouter pokazuje w statystykach uzycia. Kosmetyka.
LOTIS_AI_REFERER=https://localhost/lotis
LOTIS_AI_TITLE=LOTIS V1

# ---- Zrodla danych ---------------------------------------------------------
# Puste = szukaj automatycznie: katalog data/ w projekcie, potem
# ~/Downloads/dane. Ustaw sciezke tylko, gdy trzymasz pliki gdzie indziej.

LOTIS_LOOPS_JSX=
LOTIS_SIATKA_JSON=

# ---- Silnik ----------------------------------------------------------------

# Budzet czasu na jeden run w milisekundach (luka 10 tablicy).
# Po przekroczeniu progow silnik schodzi po drabinie degradacji zamiast
# zwracac nic.
LOTIS_BUDGET_MS=20000

# Ziarno generatora manifestu. Ten sam numer = ten sam manifest,
# wiec testy golden-file maja sens.
LOTIS_SEED=2026
