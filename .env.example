# ============================================================================
# LOTIS V1 -- wzorzec konfiguracji
# Skopiuj do .env i uzupelnij klucz:   copy .env.example .env
# ============================================================================

# ---- Warstwa AI (OUTPUT 2) -- OpenRouter -----------------------------------
OPENROUTER_API_KEY=sk-or-v1-TWOJ_KLUCZ_TUTAJ
LOTIS_AI_MODEL=minimax/minimax-m3:free
LOTIS_AI_REFERER=https://localhost/lotis
LOTIS_AI_TITLE=LOTIS V1

# ---- Zrodla danych (puste = szukaj automatycznie) --------------------------
LOTIS_LOOPS_JSX=
LOTIS_SIATKA_JSON=

# ---- Silnik ----------------------------------------------------------------
LOTIS_BUDGET_MS=20000
LOTIS_SEED=2026
